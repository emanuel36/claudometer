# A headless GNOME Shell to load the extension in; BASE picks the Ubuntu release, and so the
# GNOME version (see run.sh).
ARG BASE=ubuntu:24.04
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive
# A release past its end of life has moved from the main mirrors to old-releases
RUN { apt-get update || { \
        for f in /etc/apt/sources.list /etc/apt/sources.list.d/*; do \
            [ -f "$f" ] && sed -i -E \
                's#//(archive|security)\.ubuntu\.com#//old-releases.ubuntu.com#g' "$f"; \
        done; \
        apt-get update; }; } \
    && apt-get install -y --no-install-recommends \
        gnome-shell gnome-shell-extension-prefs gjs libglib2.0-bin dbus xwayland \
        libgl1-mesa-dri librsvg2-common ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
# GNOME 42 loads Soup 2.4; with Soup 3 installed next to it, the test proves the extension uses
# the one the shell has loaded
RUN . /etc/os-release && if [ "$VERSION_ID" = 22.04 ]; then \
        apt-get update && apt-get install -y --no-install-recommends gir1.2-soup-3.0 \
        && rm -rf /var/lib/apt/lists/*; fi
# Xwayland needs it, even with no X11 client
RUN mkdir -m 1777 -p /tmp/.X11-unix
RUN useradd --create-home tester
USER tester
WORKDIR /home/tester
