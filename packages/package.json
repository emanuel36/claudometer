{
  "name": "claudometer-packages",
  "private": true,
  "description": "The Node side of Claudometer: the shared core, the CLI and the VS Code extension",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "core",
    "cli",
    "vscode"
  ],
  "scripts": {
    "test": "node scripts/gjs-tests.mjs && node --test \"core/test/*.test.js\" \"cli/test/*.test.js\"",
    "build": "npm run build --workspace cli --workspace vscode",
    "package": "npm run package --workspace vscode"
  },
  "engines": {
    "node": ">=18.17"
  }
}
